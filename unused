<!doctype html>
<html><head><meta charset="utf-8"><style>
body{font-family:"IBM Plex Sans","Segoe UI",system-ui,sans-serif;background:#f2f3f6;padding:24px;display:flex;gap:24px;flex-wrap:wrap}
.col{display:flex;flex-direction:column;gap:10px}
.col h3{font-family:sans-serif;font-size:13px;margin:0 0 4px}
.dark{background:#14161b;padding:16px;border-radius:8px}
.show{position:relative;text-align:left;border:1px solid transparent;border-radius:4px;padding:6px 8px;display:block;width:220px;
      font-size:12px;line-height:1.25;overflow:hidden;font-family:inherit}
.show .name{font-weight:600;display:block}
.show .meta{display:block;font-size:10.5px;opacity:.85}
.light-current{background:#c9ecd8;color:#1c6b45}
.light-white{background:#c9ecd8;color:#fff}
.dark-current{background:#1d4634;color:#b9f0d2}
.dark-white{background:#1d4634;color:#fff}
</style></head>
<body>
<div class="col">
  <h3>Light mode — current (green text)</h3>
  <div class="show light-current"><span class="name">Merkules</span><span class="meta">Frankies · 7:00 PM</span></div>
  <h3>Light mode — white text</h3>
  <div class="show light-white"><span class="name">Merkules</span><span class="meta">Frankies · 7:00 PM</span></div>
</div>
<div class="dark col">
  <h3 style="color:#e9ebf1">Dark mode — current (already white)</h3>
  <div class="show dark-white"><span class="name">Merkules</span><span class="meta">Frankies · 7:00 PM</span></div>
  <h3 style="color:#e9ebf1">Dark mode — pale green (old, pre-fix)</h3>
  <div class="show dark-current"><span class="name">Merkules</span><span class="meta">Frankies · 7:00 PM</span></div>
</div>
</body></html>

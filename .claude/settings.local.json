{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(railway *)",
      "PowerShell(railway *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(python -c ' *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PROJECT_DIR:-$PWD}/_git_checkpoint.sh\"; [ -f \"$S\" ] && bash \"$S\"; exit 0",
            "shell": "bash",
            "timeout": 90,
            "statusMessage": "backing up to GitHub…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/timehook.sh\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; git -C \"$D\" remote get-url origin >/dev/null 2>&1 || exit 0; out=$(git -C \"$D\" pull -q --rebase origin main 2>&1); if [ $? -eq 0 ]; then printf '{\"systemMessage\":\"ConcertPros: pulled latest from GitHub.\"}'; else printf '{\"systemMessage\":\"WARNING: ConcertPros could not pull from GitHub — %s\"}' \"$(printf '%s' \"$out\" | tr -d '\\n\"' | head -c 200)\"; fi; exit 0",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "pulling latest from GitHub…"
          }
        ]
      }
    ]
  }
}
